# This repository holds the project's text: code, tools, settings and notes.
# Everything binary, generated or fetched stays out: it is large, it cannot be merged, and the tools can make most of it again.
/Content/
/ArtSource/
/Saved/
/Intermediate/
/DerivedDataCache/
/Binaries/

# another project's data that happens to live here, and this machine's own tool settings
/dataset/
/.claude/
/.mcp.json

# films, pictures, sounds and models wherever they turn up (for-review is mostly these)
*.mp4
*.jpg
*.png
*.wav
*.fbx
*.glb
*.blend
*.uasset
*.umap

# except the README's own pictures
!/docs/media/*.jpg

