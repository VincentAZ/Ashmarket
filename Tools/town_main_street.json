 "people_about": "'beat' is a round somebody walks: each stop is [x, y, seconds they stand there, the way they look while they do]. They go from each stop to the next and from the last back to the first. Each walks a line of their own down the road (x -2.9, -1.4, -0.4, 1.0, 2.9), so that nobody walks through anybody.",
 "people": [
  {
   "name": "Needle", "prompt": "Talk to Needle, at Hide & Plate", "body": "Ada", "cloth": [0.32, 0.31, 0.28],
   "x": -7.5, "y": 95.0, "facing": 90, "idle": "crowd_watch_hands_on_hips",
   "lines": [
    {"id": "counter", "words": "Arms up. Turn. You stand like somebody who gets hit on the left. We cut ring armor for the Gut: tire rubber for what is swung at you, road sign for what is edged. Water in hand. Nothing here goes on a slate.",
     "answers": [
      {"words": "Show me what is on the counter.", "deed": "armor"},
      {"words": "Which do I want?", "next": "which"},
      {"words": "Not today."}
     ]},
    {"id": "which", "words": "Rubber takes the weight out of a club or a chain. Sign plate turns an edge. Nothing does both. Find out who you are fighting, and then find out what they carry.",
     "answers": [
      {"words": "Show me what is on the counter.", "deed": "armor"},
      {"words": "I will find out first."}
     ]}
   ]
  },
  {
   "name": "Thread", "prompt": "Talk to Thread", "body": "Ada", "cloth": [0.3, 0.3, 0.29],
   "x": -7.3, "y": 98.4, "facing": 100, "idle": "crowd_watch_hands_behind",
   "lines": [
    {"id": "line", "words": "Needle sells you the plate. I would sooner know who it is for. Come by when the line is not running, and sit. Tonight it is running."}
   ]
  },
  {
   "name": "Brass", "prompt": "Talk to Brass, at Tooth & Trigger", "body": "Mix02", "cloth": [0.05, 0.07, 0.05],
   "x": 5.1, "y": 63.2, "facing": 270, "idle": "crowd_watch_arms_crossed",
   "lines": [
    {"id": "drawer", "words": "Scrap, tuned or relic. Scrap is cheap because you'll be back. Relic is dear because you won't.",
     "answers": [
      {"words": "What do you sell a fighter?", "next": "fighter"},
      {"words": "The truck's colors. What do they pay?", "next": "colors"},
      {"words": "Nothing."}
     ]},
    {"id": "fighter", "words": "Nothing the Gut lets through its door. Hasp racks what you fight with, and Hasp does not take mine. When you have a tag and a reason, come back and I will find you a tool."},
    {"id": "colors", "words": "Ten litres a fight to wear them, from Butcher rank. The offer comes to your card at the Gut. I do not chase fighters down the street."}
   ]
  },
  {
   "name": "Gate Warden", "prompt": "Talk to the Warden at the barrier", "body": "Mix04", "cloth": [0.035, 0.04, 0.055],
   "x": 2.2, "y": 42.3, "facing": 0, "idle": "crowd_watch_arms_crossed",
   "lines": [
    {"id": "shut", "words": "Gate Yard is shut to foot traffic until the bell. You can see the gate from here, and that is as near as you get tonight."}
   ]
  },
  {
   "name": "Stallholder", "prompt": "Talk to the stallholder", "body": "Mix07", "cloth": [0.09, 0.06, 0.04],
   "x": -6.7, "y": 72.0, "facing": 90, "idle": "crowd_watch_hands_behind",
   "lines": [
    {"id": "bread", "words": "Bread's hot. Water first, then bread. That is the order everything goes in here."}
   ]
  },
  {
   "name": "Scrap seller", "prompt": "Talk to the scrap seller", "body": "Sookja", "cloth": [0.06, 0.06, 0.05],
   "x": 7.4, "y": 84.0, "facing": 270, "idle": "crowd_watch_relaxed",
   "lines": [
    {"id": "table", "words": "If it is on the table it is for sale. If it is under the table it is sold. If it is yours, you should have kept hold of it."}
   ]
